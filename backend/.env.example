PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=havefun
DB_PASSWORD=changeme
DB_DATABASE=havefun_courses

JWT_SECRET=changeme
JWT_EXPIRES_IN_SECONDS=86400

# Démo locale uniquement : 1 = désactive l'authentification, toutes les requêtes
# sont traitées comme l'utilisateur de démonstration (voir `npm run seed`).
# Requis par la webapp (dossier `webapp/`). Laisser à 0 en production.
AUTH_DISABLED=0

# Racine de stockage des médias sur le disque du serveur backend.
MEDIA_STORAGE_DIR=./storage/media
